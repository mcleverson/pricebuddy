# @see https://github.com/laravel/laravel/blob/11.x/.env.example for possible values
APP_KEY=

MERCADO_LIVRE_API_URL=https://api.mercadolibre.com
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=
SCRAPER_PROXY_MODE=disabled
# Comma/newline separated proxy URLs. Credentials are accepted here but never logged.
SCRAPER_PROXIES=
SCRAPER_PROXY_MAX_ATTEMPTS=2
SCRAPER_PROXY_FAILURE_THRESHOLD=2
SCRAPER_PROXY_COOLDOWN_SECONDS=300
SCRAPER_PROXY_STATE_TTL_SECONDS=86400
